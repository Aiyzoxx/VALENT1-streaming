{
  "expo": {
    "name": "StreamFlow",
    "slug": "streamflow",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0E14",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.valent1.streamflow",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "UIViewControllerBasedStatusBarAppearance": false,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "StreamFlow utilise le microphone pour la recherche vocale.",
        "NSSpeechRecognitionUsageDescription": "StreamFlow utilise la reconnaissance vocale pour vous aider à trouver des films et séries rapidement."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0E14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.valent1.streamflow",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "StreamFlow utilise le microphone pour la recherche vocale.",
          "speechRecognitionPermission": "StreamFlow utilise la reconnaissance vocale pour trouver des films et séries rapidement."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e825d3a2-5b1c-4163-9903-5e80dfda690d"
      }
    }
  }
}
